-- Musicfy iOS port: SQLDelight equivalent of Android Room InternalDatabase v41.
-- All timestamps are epoch millis stored as INTEGER (Room Converters behaviour).

CREATE TABLE song (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  duration INTEGER NOT NULL DEFAULT -1,
  thumbnailUrl TEXT,
  albumId TEXT,
  albumName TEXT,
  explicit INTEGER NOT NULL DEFAULT 0,
  year INTEGER,
  date INTEGER,
  dateModified INTEGER,
  liked INTEGER NOT NULL DEFAULT 0,
  likedDate INTEGER,
  totalPlayTime INTEGER NOT NULL DEFAULT 0,
  inLibrary INTEGER,
  dateDownload INTEGER,
  isLocal INTEGER NOT NULL DEFAULT 0,
  libraryAddToken TEXT,
  libraryRemoveToken TEXT,
  lyricsOffset INTEGER NOT NULL DEFAULT 0,
  romanizeLyrics INTEGER NOT NULL DEFAULT 1,
  isDownloaded INTEGER NOT NULL DEFAULT 0,
  isUploaded INTEGER NOT NULL DEFAULT 0,
  isVideo INTEGER NOT NULL DEFAULT 0,
  localUri TEXT
);

CREATE INDEX song_album_id ON song(albumId);

CREATE TABLE artist (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  thumbnailUrl TEXT,
  channelId TEXT,
  lastUpdateTime INTEGER NOT NULL DEFAULT 0,
  bookmarkedAt INTEGER,
  isLocal INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE album (
  id TEXT NOT NULL PRIMARY KEY,
  playlistId TEXT,
  title TEXT NOT NULL,
  year INTEGER,
  thumbnailUrl TEXT,
  themeColor INTEGER,
  songCount INTEGER NOT NULL DEFAULT 0,
  duration INTEGER NOT NULL DEFAULT 0,
  explicit INTEGER NOT NULL DEFAULT 0,
  lastUpdateTime INTEGER NOT NULL DEFAULT 0,
  bookmarkedAt INTEGER,
  likedDate INTEGER,
  inLibrary INTEGER,
  description TEXT,
  isLocal INTEGER NOT NULL DEFAULT 0,
  isUploaded INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE playlist (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  browseId TEXT,
  createdAt INTEGER,
  lastUpdateTime INTEGER,
  isEditable INTEGER NOT NULL DEFAULT 1,
  bookmarkedAt INTEGER,
  remoteSongCount INTEGER,
  playEndpointParams TEXT,
  thumbnailUrl TEXT,
  shuffleEndpointParams TEXT,
  radioEndpointParams TEXT,
  isLocal INTEGER NOT NULL DEFAULT 0,
  isAutoSync INTEGER NOT NULL DEFAULT 0,
  description TEXT
);

CREATE TABLE song_artist_map (
  songId TEXT NOT NULL,
  artistId TEXT NOT NULL,
  position INTEGER NOT NULL,
  PRIMARY KEY (songId, artistId),
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE,
  FOREIGN KEY (artistId) REFERENCES artist(id) ON DELETE CASCADE
);

CREATE INDEX song_artist_map_artist ON song_artist_map(artistId);

CREATE TABLE song_album_map (
  songId TEXT NOT NULL,
  albumId TEXT NOT NULL,
  `index` INTEGER NOT NULL,
  PRIMARY KEY (songId, albumId),
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE,
  FOREIGN KEY (albumId) REFERENCES album(id) ON DELETE CASCADE
);

CREATE TABLE album_artist_map (
  albumId TEXT NOT NULL,
  artistId TEXT NOT NULL,
  `order` INTEGER NOT NULL,
  PRIMARY KEY (albumId, artistId),
  FOREIGN KEY (albumId) REFERENCES album(id) ON DELETE CASCADE,
  FOREIGN KEY (artistId) REFERENCES artist(id) ON DELETE CASCADE
);

CREATE TABLE playlist_song_map (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  playlistId TEXT NOT NULL,
  songId TEXT NOT NULL,
  position INTEGER NOT NULL,
  setVideoId TEXT,
  FOREIGN KEY (playlistId) REFERENCES playlist(id) ON DELETE CASCADE,
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE
);

CREATE INDEX playlist_song_map_playlist ON playlist_song_map(playlistId);
CREATE INDEX playlist_song_map_song ON playlist_song_map(songId);

CREATE TABLE search_history (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  query TEXT NOT NULL UNIQUE
);

CREATE TABLE format (
  id TEXT NOT NULL PRIMARY KEY,
  itag INTEGER NOT NULL,
  mimeType TEXT NOT NULL,
  codecs TEXT NOT NULL,
  bitrate INTEGER NOT NULL,
  sampleRate INTEGER,
  contentLength INTEGER NOT NULL DEFAULT 0,
  loudnessDb REAL,
  perceptualLoudnessDb REAL,
  playbackUrl TEXT
);

CREATE TABLE lyrics (
  id TEXT NOT NULL PRIMARY KEY,
  lyrics TEXT NOT NULL,
  provider TEXT NOT NULL DEFAULT 'Unknown',
  translatedLyrics TEXT NOT NULL DEFAULT '',
  translationLanguage TEXT NOT NULL DEFAULT '',
  translationMode TEXT NOT NULL DEFAULT ''
);

CREATE TABLE event (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  songId TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  playTime INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE
);

CREATE INDEX event_song ON event(songId);

CREATE TABLE related_song_map (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  songId TEXT NOT NULL,
  relatedSongId TEXT NOT NULL,
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE,
  FOREIGN KEY (relatedSongId) REFERENCES song(id) ON DELETE CASCADE
);

CREATE INDEX related_song_map_song ON related_song_map(songId);
CREATE INDEX related_song_map_related ON related_song_map(relatedSongId);

CREATE TABLE set_video_id (
  videoId TEXT NOT NULL PRIMARY KEY,
  setVideoId TEXT
);

CREATE TABLE playCount (
  song TEXT NOT NULL,
  year INTEGER NOT NULL,
  month INTEGER NOT NULL,
  count INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (song, year, month)
);

CREATE TABLE recognition_history (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  trackId TEXT NOT NULL,
  title TEXT NOT NULL,
  artist TEXT NOT NULL,
  album TEXT,
  coverArtUrl TEXT,
  coverArtHqUrl TEXT,
  genre TEXT,
  releaseDate TEXT,
  label TEXT,
  shazamUrl TEXT,
  appleMusicUrl TEXT,
  spotifyUrl TEXT,
  isrc TEXT,
  youtubeVideoId TEXT,
  recognizedAt INTEGER NOT NULL,
  liked INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX recognition_history_track ON recognition_history(trackId);

CREATE TABLE speed_dial_item (
  id TEXT NOT NULL PRIMARY KEY,
  secondaryId TEXT,
  title TEXT NOT NULL,
  subtitle TEXT,
  thumbnailUrl TEXT,
  type TEXT NOT NULL,
  explicit INTEGER NOT NULL DEFAULT 0,
  createDate INTEGER NOT NULL
);

CREATE TABLE playlist_event (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  playlistId TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  FOREIGN KEY (playlistId) REFERENCES playlist(id) ON DELETE CASCADE
);

CREATE INDEX playlist_event_playlist ON playlist_event(playlistId);

CREATE TABLE imported_song (
  songId TEXT NOT NULL,
  source TEXT NOT NULL,
  importedAt INTEGER NOT NULL,
  PRIMARY KEY (songId, source)
);

CREATE INDEX imported_song_source ON imported_song(source);

CREATE TABLE import_session (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  source TEXT NOT NULL,
  startedAt INTEGER NOT NULL
);

CREATE TABLE import_session_song (
  sessionId INTEGER NOT NULL,
  songId TEXT NOT NULL,
  addedToLibrary INTEGER NOT NULL DEFAULT 0,
  liked INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (sessionId, songId)
);

CREATE INDEX import_session_song_song ON import_session_song(songId);

CREATE TABLE imported_playlist (
  playlistId TEXT NOT NULL PRIMARY KEY,
  source TEXT NOT NULL,
  sessionId INTEGER,
  importedAt INTEGER NOT NULL,
  remoteId TEXT,
  remoteUrl TEXT,
  lastSyncedAt INTEGER
);

CREATE TABLE imported_playlist_track (
  playlistId TEXT NOT NULL,
  trackKey TEXT NOT NULL,
  PRIMARY KEY (playlistId, trackKey)
);

CREATE VIEW sorted_song_album_map AS
SELECT * FROM song_album_map ORDER BY `index`;

CREATE VIEW sorted_song_artist_map AS
SELECT * FROM song_artist_map ORDER BY position;

CREATE VIEW playlist_song_map_preview AS
SELECT * FROM playlist_song_map WHERE position <= 3 ORDER BY position;

-- Library queries (Room DatabaseDao equivalents)
selectLikedSongs:
SELECT * FROM song WHERE liked = 1 ORDER BY likedDate DESC;

selectLibrarySongs:
SELECT * FROM song WHERE inLibrary IS NOT NULL ORDER BY inLibrary DESC;

selectDownloadedSongs:
SELECT * FROM song WHERE isDownloaded = 1 ORDER BY dateDownload DESC;

countLikedSongs:
SELECT COUNT(1) FROM song WHERE liked = 1;

updateLike:
UPDATE song SET liked = ?, likedDate = ? WHERE id = ?;

updateLibrary:
UPDATE song SET inLibrary = ?, liked = ?, likedDate = ? WHERE id = ?;

updateDownloaded:
UPDATE song SET isDownloaded = ?, dateDownload = ? WHERE id = ?;

insertSong:
INSERT OR IGNORE INTO song(
  id, title, duration, thumbnailUrl, albumId, albumName, explicit, year, date,
  dateModified, liked, likedDate, totalPlayTime, inLibrary, dateDownload, isLocal,
  libraryAddToken, libraryRemoveToken, lyricsOffset, romanizeLyrics, isDownloaded,
  isUploaded, isVideo, localUri
) VALUES (
  ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?
);

-- Listening history and stats
insertEvent:
INSERT OR IGNORE INTO event(songId, timestamp, playTime) VALUES (?, ?, ?);

recentEvents:
SELECT * FROM event ORDER BY id DESC LIMIT ?;

recapEvents:
SELECT songId, timestamp, playTime FROM event
WHERE timestamp >= ? AND timestamp < ? ORDER BY timestamp;

totalListeningTimeMs:
SELECT COALESCE(SUM(playTime), 0) FROM event;

incrementTotalPlayTime:
UPDATE song SET totalPlayTime = totalPlayTime + ? WHERE id = ?;

clearListenHistory:
DELETE FROM event;

mostPlayedSongs:
SELECT songId, COUNT(1) AS playCount, SUM(playTime) AS totalPlayTime
FROM event GROUP BY songId ORDER BY totalPlayTime DESC LIMIT ?;

uniqueSongCountInRange:
SELECT COUNT(DISTINCT songId) FROM event WHERE timestamp >= ? AND timestamp < ?;

-- Search history
searchHistory:
SELECT id, `query` FROM search_history WHERE `query` LIKE ? || '%' ORDER BY id DESC LIMIT ?;

insertSearchHistory:
INSERT OR REPLACE INTO search_history(query) VALUES (?);

clearSearchHistory:
DELETE FROM search_history;

-- Playlists
insertPlaylistSong:
INSERT INTO playlist_song_map(playlistId, songId, position, setVideoId) VALUES (?, ?, ?, ?);

playlistSongIds:
SELECT songId FROM playlist_song_map WHERE playlistId = ? ORDER BY position;

clearPlaylist:
DELETE FROM playlist_song_map WHERE playlistId = ?;

removePlaylistSongsFrom:
DELETE FROM playlist_song_map WHERE playlistId = ? AND position >= ?;

bookmarkPlaylist:
UPDATE playlist SET bookmarkedAt = ? WHERE id = ?;

bookmarkedPlaylists:
SELECT * FROM playlist WHERE bookmarkedAt IS NOT NULL ORDER BY bookmarkedAt DESC;

-- Lyrics
selectLyrics:
SELECT * FROM lyrics WHERE id = ?;

insertLyrics:
INSERT OR REPLACE INTO lyrics(id, lyrics, provider, translatedLyrics, translationLanguage, translationMode)
VALUES (?, ?, ?, ?, ?, ?);

-- Speed dial (limit enforced in MusicDatabase, MaxPinned = 9)
speedDialItems:
SELECT * FROM speed_dial_item ORDER BY createDate DESC LIMIT 9;

-- Single songs and batched song lookups (facade ops 2)
songById:
SELECT * FROM song WHERE id = :songId;

songArtistMap:
SELECT * FROM song_artist_map WHERE songId = :songId ORDER BY position;

songsByIds:
SELECT * FROM song WHERE id IN :songIds;

-- Sorted library/liked lists (facade op 3). The facade keeps the inLibrary IS NOT NULL
-- filter in Kotlin so these queries all map to the generated Song row type.
-- SQLDelight validates identifiers against CREATE TABLE, so use the declared PRIMARY KEY
-- instead of SQLite's implicit rowid as the stable insertion-order tiebreaker.
songsByRowIdAsc:
SELECT * FROM song ORDER BY id;

songsByCreateDateAsc:
SELECT * FROM song ORDER BY inLibrary, id;

songsByNameAsc:
SELECT * FROM song ORDER BY title;

songsByPlayTimeAsc:
SELECT * FROM song ORDER BY totalPlayTime;

likedSongsByRowIdAsc:
SELECT * FROM song WHERE liked = 1 ORDER BY id;

likedSongsByCreateDateAsc:
SELECT * FROM song WHERE liked = 1 ORDER BY likedDate;

likedSongsByNameAsc:
SELECT * FROM song WHERE liked = 1 ORDER BY title;

likedSongsByPlayTimeAsc:
SELECT * FROM song WHERE liked = 1 ORDER BY totalPlayTime;

-- Album lookups and lists (facade op 4)
albumById:
SELECT * FROM album WHERE id = :albumId;

albumsByCreateDateAsc:
SELECT * FROM album ORDER BY id;

albumsByNameAsc:
SELECT * FROM album ORDER BY title;

albumsByYearAsc:
SELECT * FROM album ORDER BY year;

albumsBySongCountAsc:
SELECT * FROM album ORDER BY songCount;

albumsByLengthAsc:
SELECT * FROM album ORDER BY duration;

albumsByPlayTimeAsc:
SELECT album.* FROM album
JOIN song ON song.albumId = album.id
GROUP BY album.id
ORDER BY SUM(song.totalPlayTime);

albumSongs:
SELECT song.* FROM song
JOIN song_album_map ON song.id = song_album_map.songId
WHERE song_album_map.albumId = :albumId
ORDER BY song_album_map.`index`;

-- Artist lookups and lists (facade op 5)
artistById:
SELECT * FROM artist WHERE id = :artistId;

artistByName:
SELECT * FROM artist WHERE name = :name LIMIT 1;

artistsByCreateDateAsc:
SELECT * FROM artist ORDER BY id;

artistsByNameAsc:
SELECT * FROM artist ORDER BY name;

artistsBySongCountAsc:
SELECT ar.* FROM artist ar
JOIN (SELECT artistId, COUNT(1) AS songCount FROM song_artist_map GROUP BY artistId) counts
  ON ar.id = counts.artistId
ORDER BY counts.songCount;

artistsByPlayTimeAsc:
SELECT ar.* FROM artist ar
JOIN (SELECT sam.artistId, SUM(s.totalPlayTime) AS totalPlayTime
      FROM song_artist_map sam JOIN song s ON s.id = sam.songId
      GROUP BY sam.artistId) totals ON ar.id = totals.artistId
ORDER BY totals.totalPlayTime;

artistSongsByCreateDateAsc:
SELECT song.* FROM song_artist_map sam
JOIN song ON song.id = sam.songId
WHERE sam.artistId = :artistId
ORDER BY song.inLibrary;

artistSongsByNameAsc:
SELECT song.* FROM song_artist_map sam
JOIN song ON song.id = sam.songId
WHERE sam.artistId = :artistId
ORDER BY song.title;

artistSongsByPlayTimeAsc:
SELECT song.* FROM song_artist_map sam
JOIN song ON song.id = sam.songId
WHERE sam.artistId = :artistId
ORDER BY song.totalPlayTime;

artistSongsPreview:
SELECT song.* FROM song_artist_map sam
JOIN song ON song.id = sam.songId
WHERE sam.artistId = :artistId
LIMIT :previewSize;

mostPlayedSongsByArtist:
SELECT song.* FROM song
JOIN (SELECT e.songId, SUM(e.playTime) AS totalPlayTime
      FROM event e
      JOIN song_artist_map sam ON e.songId = sam.songId
      WHERE sam.artistId = :artistId
        AND e.timestamp >= :fromTimestamp AND e.timestamp <= :toTimestamp
      GROUP BY e.songId
      ORDER BY totalPlayTime DESC) plays ON song.id = plays.songId
ORDER BY plays.totalPlayTime DESC;

mostPlayedArtists:
SELECT ar.*,
       (SELECT COUNT(1) FROM song_artist_map sam JOIN event e ON sam.songId = e.songId
        WHERE sam.artistId = ar.id
          AND e.timestamp >= :fromTimestamp AND e.timestamp <= :toTimestamp) AS songCount,
       (SELECT SUM(e.playTime) FROM song_artist_map sam JOIN event e ON sam.songId = e.songId
        WHERE sam.artistId = ar.id
          AND e.timestamp >= :fromTimestamp AND e.timestamp <= :toTimestamp) AS timeListened
FROM artist ar
JOIN (SELECT sam.artistId, SUM(e.playTime) AS totalPlayTime
      FROM song_artist_map sam JOIN event e ON sam.songId = e.songId
      WHERE e.timestamp >= :fromTimestamp AND e.timestamp <= :toTimestamp
      GROUP BY sam.artistId
      ORDER BY totalPlayTime DESC
      LIMIT :limit OFFSET :offset) totals ON ar.id = totals.artistId
ORDER BY totals.totalPlayTime DESC;

-- Playlist lookups and lists (facade op 6)
playlistById:
SELECT * FROM playlist WHERE id = :playlistId;

playlistByBrowseId:
SELECT * FROM playlist WHERE browseId = :browseId;

playlistsByCreateDateAsc:
SELECT * FROM playlist ORDER BY id;

playlistsByUpdatedDateAsc:
SELECT * FROM playlist ORDER BY lastUpdateTime;

playlistsByNameAsc:
SELECT * FROM playlist ORDER BY name;

playlistsBySongCountAsc:
SELECT pl.* FROM playlist pl
JOIN (SELECT playlistId, COUNT(1) AS songCount FROM playlist_song_map GROUP BY playlistId) counts
  ON pl.id = counts.playlistId
ORDER BY counts.songCount;

playlistSongMaps:
SELECT * FROM playlist_song_map WHERE playlistId = :playlistId ORDER BY position;

playlistSongMapsBySongId:
SELECT * FROM playlist_song_map WHERE songId = :songId;

playlistDuplicates:
SELECT songId FROM playlist_song_map
WHERE playlistId = :playlistId AND songId IN :songIds;

checkInPlaylist:
SELECT COUNT(1) FROM playlist_song_map
WHERE playlistId = :playlistId AND songId = :songId;

playlistIdsContainingSongs:
SELECT DISTINCT playlistId FROM playlist_song_map WHERE songId IN :songIds;

insertPlaylistSongMap:
INSERT OR IGNORE INTO playlist_song_map(playlistId, songId, position, setVideoId)
VALUES (:playlistId, :songId, :position, :setVideoId);

-- Repeated named parameters are deduplicated by SQLDelight, so the generated argument order is
-- fromPosition, toPosition, playlistId, minPosition, maxPosition.
movePlaylistSong:
UPDATE playlist_song_map SET position =
  CASE
    WHEN position < :fromPosition THEN position + 1
    WHEN position > :fromPosition THEN position - 1
    ELSE :toPosition
  END
WHERE playlistId = :playlistId AND position BETWEEN :minPosition AND :maxPosition;

removeAddedSongs:
DELETE FROM playlist_song_map
WHERE playlistId = :playlistId AND songId IN :songIds AND position >= :fromPosition;

-- Search (facade op 7)
searchSongs:
SELECT * FROM song WHERE title LIKE '%' || :searchQuery || '%' LIMIT :limit;

searchArtists:
SELECT * FROM artist WHERE name LIKE '%' || :searchQuery || '%' LIMIT :limit;

searchAlbums:
SELECT * FROM album WHERE title LIKE '%' || :searchQuery || '%' LIMIT :limit;

searchPlaylists:
SELECT * FROM playlist WHERE name LIKE '%' || :searchQuery || '%' LIMIT :limit;

-- Format, lyrics and set-video-id (facade op 8)
formatById:
SELECT * FROM format WHERE id = :id;

lyricsById:
SELECT * FROM lyrics WHERE id = :id;

setVideoIdByVideoId:
SELECT * FROM set_video_id WHERE videoId = :videoId;

updateLyricsOffset:
UPDATE song SET lyricsOffset = :lyricsOffset WHERE id = :songId;

upsertFormat:
INSERT OR REPLACE INTO format(id, itag, mimeType, codecs, bitrate, sampleRate, contentLength,
                              loudnessDb, perceptualLoudnessDb, playbackUrl)
VALUES (:id, :itag, :mimeType, :codecs, :bitrate, :sampleRate, :contentLength,
        :loudnessDb, :perceptualLoudnessDb, :playbackUrl);

insertSetVideoId:
INSERT OR REPLACE INTO set_video_id(videoId, setVideoId) VALUES (:videoId, :setVideoId);

-- Events (facade op 9)
events:
SELECT * FROM event ORDER BY id DESC;

recentEventsLimited:
SELECT * FROM event ORDER BY id DESC LIMIT :limit;

firstEvent:
SELECT * FROM event ORDER BY id ASC LIMIT 1;

eventCount:
SELECT COUNT(1) FROM event;

firstEventTimestamp:
SELECT MIN(timestamp) FROM event;

recapEventsRange:
SELECT songId, timestamp, playTime FROM event
WHERE timestamp >= :fromTimestamp AND timestamp < :toTimestamp
ORDER BY timestamp;

recentlyPlayedSongs:
SELECT song.* FROM song
JOIN (SELECT songId, MAX(timestamp) AS lastPlayed FROM event GROUP BY songId) plays
  ON song.id = plays.songId
ORDER BY plays.lastPlayed DESC
LIMIT :limit;

mostPlayedSongsInRange:
SELECT song.* FROM song
JOIN (SELECT songId, SUM(playTime) AS totalPlayTime
      FROM event
      WHERE timestamp >= :fromTimestamp AND timestamp <= :toTimestamp
      GROUP BY songId
      ORDER BY totalPlayTime DESC
      LIMIT :limit OFFSET :offset) plays ON song.id = plays.songId
ORDER BY plays.totalPlayTime DESC;

-- Relations, batched where possible so a screen of songs costs a fixed number of queries
songArtists:
SELECT ar.* FROM song_artist_map sam
JOIN artist ar ON ar.id = sam.artistId
WHERE sam.songId = :songId
ORDER BY sam.position;

songAlbum:
SELECT al.* FROM song_album_map sm
JOIN album al ON al.id = sm.albumId
WHERE sm.songId = :songId
ORDER BY sm.`index`
LIMIT 1;

albumArtists:
SELECT ar.* FROM album_artist_map am
JOIN artist ar ON ar.id = am.artistId
WHERE am.albumId = :albumId
ORDER BY am.`order`;

songArtistsForSongIds:
SELECT sam.songId AS songId, ar.id, ar.name, ar.thumbnailUrl, ar.channelId,
       ar.lastUpdateTime, ar.bookmarkedAt, ar.isLocal
FROM song_artist_map sam
JOIN artist ar ON ar.id = sam.artistId
WHERE sam.songId IN :songIds
ORDER BY sam.songId, sam.position;

songAlbumsForSongIds:
SELECT sm.songId AS songId, al.id, al.playlistId, al.title, al.year, al.thumbnailUrl,
       al.themeColor, al.songCount, al.duration, al.explicit, al.lastUpdateTime,
       al.bookmarkedAt, al.likedDate, al.inLibrary, al.description, al.isLocal, al.isUploaded
FROM song_album_map sm
JOIN album al ON al.id = sm.albumId
WHERE sm.songId IN :songIds
ORDER BY sm.songId, sm.`index`;

albumArtistsForAlbumIds:
SELECT am.albumId AS albumId, ar.id, ar.name, ar.thumbnailUrl, ar.channelId,
       ar.lastUpdateTime, ar.bookmarkedAt, ar.isLocal
FROM album_artist_map am
JOIN artist ar ON ar.id = am.artistId
WHERE am.albumId IN :albumIds
ORDER BY am.albumId, am.`order`;

formatsByIds:
SELECT * FROM format WHERE id IN :ids;

artistLibrarySongCounts:
SELECT sam.artistId AS artistId, COUNT(1) AS songCount
FROM song_artist_map sam
JOIN song s ON s.id = sam.songId
WHERE s.inLibrary IS NOT NULL
GROUP BY sam.artistId;

libraryAlbumIds:
SELECT DISTINCT albumId FROM song WHERE albumId IS NOT NULL AND inLibrary IS NOT NULL;

playlistSongCounts:
SELECT playlistId, COUNT(1) AS songCount
FROM playlist_song_map
WHERE playlistId IN :playlistIds
GROUP BY playlistId;

playlistThumbsForIds:
SELECT m.playlistId AS playlistId, s.thumbnailUrl AS thumbnailUrl
FROM playlist_song_map m
JOIN song s ON s.id = m.songId
WHERE m.playlistId IN :playlistIds AND m.position <= 3
ORDER BY m.playlistId, m.position;

-- Entity writes used by the facade (facade op 6 and sync parity)
insertArtistEntity:
INSERT OR IGNORE INTO artist(id, name, thumbnailUrl, channelId, lastUpdateTime, bookmarkedAt, isLocal)
VALUES (:id, :name, :thumbnailUrl, :channelId, :lastUpdateTime, :bookmarkedAt, :isLocal);

insertAlbumEntity:
INSERT OR IGNORE INTO album(id, playlistId, title, year, thumbnailUrl, themeColor, songCount,
                            duration, explicit, lastUpdateTime, bookmarkedAt, likedDate,
                            inLibrary, description, isLocal, isUploaded)
VALUES (:id, :playlistId, :title, :year, :thumbnailUrl, :themeColor, :songCount,
        :duration, :explicit, :lastUpdateTime, :bookmarkedAt, :likedDate,
        :inLibrary, :description, :isLocal, :isUploaded);

insertPlaylistEntity:
INSERT OR IGNORE INTO playlist(id, name, browseId, createdAt, lastUpdateTime, isEditable,
                               bookmarkedAt, remoteSongCount, playEndpointParams, thumbnailUrl,
                               shuffleEndpointParams, radioEndpointParams, isLocal, isAutoSync, description)
VALUES (:id, :name, :browseId, :createdAt, :lastUpdateTime, :isEditable,
        :bookmarkedAt, :remoteSongCount, :playEndpointParams, :thumbnailUrl,
        :shuffleEndpointParams, :radioEndpointParams, :isLocal, :isAutoSync, :description);

insertSongArtistMap:
INSERT OR IGNORE INTO song_artist_map(songId, artistId, position)
VALUES (:songId, :artistId, :position);

insertSongAlbumMap:
INSERT OR IGNORE INTO song_album_map(songId, albumId, `index`)
VALUES (:songId, :albumId, :albumIndex);

insertAlbumArtistMap:
INSERT OR IGNORE INTO album_artist_map(albumId, artistId, `order`)
VALUES (:albumId, :artistId, :artistOrder);

-- Upstream @Upsert(song) parity without REPLACE: updating in place keeps FK relation rows.
upsertSong:
INSERT INTO song(
  id, title, duration, thumbnailUrl, albumId, albumName, explicit, year, date,
  dateModified, liked, likedDate, totalPlayTime, inLibrary, dateDownload, isLocal,
  libraryAddToken, libraryRemoveToken, lyricsOffset, romanizeLyrics, isDownloaded,
  isUploaded, isVideo, localUri
) VALUES (
  :id, :title, :duration, :thumbnailUrl, :albumId, :albumName, :explicit, :year, :date,
  :dateModified, :liked, :likedDate, :totalPlayTime, :inLibrary, :dateDownload, :isLocal,
  :libraryAddToken, :libraryRemoveToken, :lyricsOffset, :romanizeLyrics, :isDownloaded,
  :isUploaded, :isVideo, :localUri
)
ON CONFLICT(id) DO UPDATE SET
  title = excluded.title,
  duration = excluded.duration,
  thumbnailUrl = excluded.thumbnailUrl,
  albumId = excluded.albumId,
  albumName = excluded.albumName,
  explicit = excluded.explicit,
  year = excluded.year,
  date = excluded.date,
  dateModified = excluded.dateModified,
  liked = excluded.liked,
  likedDate = excluded.likedDate,
  totalPlayTime = excluded.totalPlayTime,
  inLibrary = excluded.inLibrary,
  dateDownload = excluded.dateDownload,
  isLocal = excluded.isLocal,
  libraryAddToken = excluded.libraryAddToken,
  libraryRemoveToken = excluded.libraryRemoveToken,
  lyricsOffset = excluded.lyricsOffset,
  romanizeLyrics = excluded.romanizeLyrics,
  isDownloaded = excluded.isDownloaded,
  isUploaded = excluded.isUploaded,
  isVideo = excluded.isVideo,
  localUri = excluded.localUri;

-- Speed dial CRUD (facade op 10)
speedDialItemsOrdered:
SELECT * FROM speed_dial_item ORDER BY createDate DESC;

oldestSpeedDialItem:
SELECT * FROM speed_dial_item ORDER BY createDate ASC LIMIT 1;

countSpeedDialItems:
SELECT COUNT(1) FROM speed_dial_item;

isSpeedDialPinned:
SELECT EXISTS(SELECT 1 FROM speed_dial_item WHERE id = :id);

insertSpeedDialItem:
INSERT OR REPLACE INTO speed_dial_item(id, secondaryId, title, subtitle, thumbnailUrl, type, explicit, createDate)
VALUES (:id, :secondaryId, :title, :subtitle, :thumbnailUrl, :type, :explicit, :createDate);

deleteSpeedDialItem:
DELETE FROM speed_dial_item WHERE id = :id;

-- Public-link importer (uses the imported_song / imported_playlist tables declared above).
-- Statement names are deliberately distinct from the facade's method names.
insertImportedSongTag:
INSERT OR REPLACE INTO imported_song(songId, source, importedAt) VALUES (?, ?, ?);

insertImportedPlaylistRecord:
INSERT OR REPLACE INTO imported_playlist(
  playlistId, source, sessionId, importedAt, remoteId, remoteUrl, lastSyncedAt
) VALUES (?, ?, ?, ?, ?, ?, ?);

importedPlaylistByRemoteId:
SELECT * FROM imported_playlist WHERE source = ? AND remoteId = ? LIMIT 1;

importedPlaylistSourceByPlaylistId:
SELECT source FROM imported_playlist WHERE playlistId = ? LIMIT 1;

importedPlaylistTrackKeys:
SELECT trackKey FROM imported_playlist_track WHERE playlistId = ?;

insertImportedPlaylistTrack:
INSERT OR IGNORE INTO imported_playlist_track(playlistId, trackKey) VALUES (?, ?);

playlistByName:
SELECT * FROM playlist WHERE name = ? AND isEditable = 1 ORDER BY createdAt LIMIT 1;

markSongInLibrary:
UPDATE song SET inLibrary = ?, dateModified = ? WHERE id = ?;

updatePlaylistThumbnail:
UPDATE playlist SET thumbnailUrl = ? WHERE id = ?;
