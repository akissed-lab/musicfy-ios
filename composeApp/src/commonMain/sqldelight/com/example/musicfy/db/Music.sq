-- Musicfy iOS port: SQLDelight equivalent of Android Room InternalDatabase v41.
-- All timestamps are epoch millis stored as INTEGER (Room Converters behaviour).

CREATE TABLE song (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  duration INTEGER NOT NULL DEFAULT -1,
  thumbnailUrl TEXT,
  albumId TEXT,
  albumName TEXT,
  explicit INTEGER NOT NULL DEFAULT 0,
  year INTEGER,
  date INTEGER,
  dateModified INTEGER,
  liked INTEGER NOT NULL DEFAULT 0,
  likedDate INTEGER,
  totalPlayTime INTEGER NOT NULL DEFAULT 0,
  inLibrary INTEGER,
  dateDownload INTEGER,
  isLocal INTEGER NOT NULL DEFAULT 0,
  libraryAddToken TEXT,
  libraryRemoveToken TEXT,
  lyricsOffset INTEGER NOT NULL DEFAULT 0,
  romanizeLyrics INTEGER NOT NULL DEFAULT 1,
  isDownloaded INTEGER NOT NULL DEFAULT 0,
  isUploaded INTEGER NOT NULL DEFAULT 0,
  isVideo INTEGER NOT NULL DEFAULT 0,
  localUri TEXT
);

CREATE INDEX song_album_id ON song(albumId);

CREATE TABLE artist (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  thumbnailUrl TEXT,
  channelId TEXT,
  lastUpdateTime INTEGER NOT NULL DEFAULT 0,
  bookmarkedAt INTEGER,
  isLocal INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE album (
  id TEXT NOT NULL PRIMARY KEY,
  playlistId TEXT,
  title TEXT NOT NULL,
  year INTEGER,
  thumbnailUrl TEXT,
  themeColor INTEGER,
  songCount INTEGER NOT NULL DEFAULT 0,
  duration INTEGER NOT NULL DEFAULT 0,
  explicit INTEGER NOT NULL DEFAULT 0,
  lastUpdateTime INTEGER NOT NULL DEFAULT 0,
  bookmarkedAt INTEGER,
  likedDate INTEGER,
  inLibrary INTEGER,
  description TEXT,
  isLocal INTEGER NOT NULL DEFAULT 0,
  isUploaded INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE playlist (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  browseId TEXT,
  createdAt INTEGER,
  lastUpdateTime INTEGER,
  isEditable INTEGER NOT NULL DEFAULT 1,
  bookmarkedAt INTEGER,
  remoteSongCount INTEGER,
  playEndpointParams TEXT,
  thumbnailUrl TEXT,
  shuffleEndpointParams TEXT,
  radioEndpointParams TEXT,
  isLocal INTEGER NOT NULL DEFAULT 0,
  isAutoSync INTEGER NOT NULL DEFAULT 0,
  description TEXT
);

CREATE TABLE song_artist_map (
  songId TEXT NOT NULL,
  artistId TEXT NOT NULL,
  position INTEGER NOT NULL,
  PRIMARY KEY (songId, artistId),
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE,
  FOREIGN KEY (artistId) REFERENCES artist(id) ON DELETE CASCADE
);

CREATE INDEX song_artist_map_artist ON song_artist_map(artistId);

CREATE TABLE song_album_map (
  songId TEXT NOT NULL,
  albumId TEXT NOT NULL,
  `index` INTEGER NOT NULL,
  PRIMARY KEY (songId, albumId),
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE,
  FOREIGN KEY (albumId) REFERENCES album(id) ON DELETE CASCADE
);

CREATE TABLE album_artist_map (
  albumId TEXT NOT NULL,
  artistId TEXT NOT NULL,
  `order` INTEGER NOT NULL,
  PRIMARY KEY (albumId, artistId),
  FOREIGN KEY (albumId) REFERENCES album(id) ON DELETE CASCADE,
  FOREIGN KEY (artistId) REFERENCES artist(id) ON DELETE CASCADE
);

CREATE TABLE playlist_song_map (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  playlistId TEXT NOT NULL,
  songId TEXT NOT NULL,
  position INTEGER NOT NULL,
  setVideoId TEXT,
  FOREIGN KEY (playlistId) REFERENCES playlist(id) ON DELETE CASCADE,
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE
);

CREATE INDEX playlist_song_map_playlist ON playlist_song_map(playlistId);
CREATE INDEX playlist_song_map_song ON playlist_song_map(songId);

CREATE TABLE search_history (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  query TEXT NOT NULL UNIQUE
);

CREATE TABLE format (
  id TEXT NOT NULL PRIMARY KEY,
  itag INTEGER NOT NULL,
  mimeType TEXT NOT NULL,
  codecs TEXT NOT NULL,
  bitrate INTEGER NOT NULL,
  sampleRate INTEGER,
  contentLength INTEGER NOT NULL DEFAULT 0,
  loudnessDb REAL,
  perceptualLoudnessDb REAL,
  playbackUrl TEXT
);

CREATE TABLE lyrics (
  id TEXT NOT NULL PRIMARY KEY,
  lyrics TEXT NOT NULL,
  provider TEXT NOT NULL DEFAULT 'Unknown',
  translatedLyrics TEXT NOT NULL DEFAULT '',
  translationLanguage TEXT NOT NULL DEFAULT '',
  translationMode INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE event (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  songId TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  playTime INTEGER NOT NULL DEFAULT 0,
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE
);

CREATE INDEX event_song ON event(songId);

CREATE TABLE related_song_map (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  songId TEXT NOT NULL,
  relatedSongId TEXT NOT NULL,
  FOREIGN KEY (songId) REFERENCES song(id) ON DELETE CASCADE,
  FOREIGN KEY (relatedSongId) REFERENCES song(id) ON DELETE CASCADE
);

CREATE INDEX related_song_map_song ON related_song_map(songId);
CREATE INDEX related_song_map_related ON related_song_map(relatedSongId);

CREATE TABLE set_video_id (
  videoId TEXT NOT NULL PRIMARY KEY,
  setVideoId TEXT
);

CREATE TABLE playCount (
  song TEXT NOT NULL,
  year INTEGER NOT NULL,
  month INTEGER NOT NULL,
  count INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (song, year, month)
);

CREATE TABLE recognition_history (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  trackId TEXT NOT NULL,
  title TEXT NOT NULL,
  artist TEXT NOT NULL,
  album TEXT,
  coverArtUrl TEXT,
  coverArtHqUrl TEXT,
  genre TEXT,
  releaseDate TEXT,
  label TEXT,
  shazamUrl TEXT,
  appleMusicUrl TEXT,
  spotifyUrl TEXT,
  isrc TEXT,
  youtubeVideoId TEXT,
  recognizedAt INTEGER NOT NULL,
  liked INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX recognition_history_track ON recognition_history(trackId);

CREATE TABLE speed_dial_item (
  id TEXT NOT NULL PRIMARY KEY,
  secondaryId TEXT,
  title TEXT NOT NULL,
  subtitle TEXT,
  thumbnailUrl TEXT,
  type TEXT NOT NULL,
  explicit INTEGER NOT NULL DEFAULT 0,
  createDate INTEGER NOT NULL
);

CREATE TABLE playlist_event (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  playlistId TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  FOREIGN KEY (playlistId) REFERENCES playlist(id) ON DELETE CASCADE
);

CREATE INDEX playlist_event_playlist ON playlist_event(playlistId);

CREATE TABLE imported_song (
  songId TEXT NOT NULL,
  source TEXT NOT NULL,
  importedAt INTEGER NOT NULL,
  PRIMARY KEY (songId, source)
);

CREATE INDEX imported_song_source ON imported_song(source);

CREATE TABLE import_session (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  source TEXT NOT NULL,
  startedAt INTEGER NOT NULL
);

CREATE TABLE import_session_song (
  sessionId INTEGER NOT NULL,
  songId TEXT NOT NULL,
  addedToLibrary INTEGER NOT NULL DEFAULT 0,
  liked INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (sessionId, songId)
);

CREATE INDEX import_session_song_song ON import_session_song(songId);

CREATE TABLE imported_playlist (
  playlistId TEXT NOT NULL PRIMARY KEY,
  source TEXT NOT NULL,
  sessionId INTEGER,
  importedAt INTEGER NOT NULL,
  remoteId TEXT,
  remoteUrl TEXT,
  lastSyncedAt INTEGER
);

CREATE TABLE imported_playlist_track (
  playlistId TEXT NOT NULL,
  trackKey TEXT NOT NULL,
  PRIMARY KEY (playlistId, trackKey)
);

CREATE VIEW sorted_song_album_map AS
SELECT * FROM song_album_map ORDER BY `index`;

CREATE VIEW sorted_song_artist_map AS
SELECT * FROM song_artist_map ORDER BY position;

CREATE VIEW playlist_song_map_preview AS
SELECT * FROM playlist_song_map WHERE position <= 3 ORDER BY position;

-- Library queries (Room DatabaseDao equivalents)
selectLikedSongs:
SELECT * FROM song WHERE liked = 1 ORDER BY likedDate DESC;

selectLibrarySongs:
SELECT * FROM song WHERE inLibrary IS NOT NULL ORDER BY inLibrary DESC;

selectDownloadedSongs:
SELECT * FROM song WHERE isDownloaded = 1 ORDER BY dateDownload DESC;

countLikedSongs:
SELECT COUNT(1) FROM song WHERE liked = 1;

updateLike:
UPDATE song SET liked = ?, likedDate = ? WHERE id = ?;

updateLibrary:
UPDATE song SET inLibrary = ?, liked = ?, likedDate = ? WHERE id = ?;

updateDownloaded:
UPDATE song SET isDownloaded = ?, dateDownload = ? WHERE id = ?;

insertSong:
INSERT OR REPLACE INTO song(
  id, title, duration, thumbnailUrl, albumId, albumName, explicit, year, date,
  dateModified, liked, likedDate, totalPlayTime, inLibrary, dateDownload, isLocal,
  libraryAddToken, libraryRemoveToken, lyricsOffset, romanizeLyrics, isDownloaded,
  isUploaded, isVideo, localUri
) VALUES (
  ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?
);

-- Listening history and stats
insertEvent:
INSERT OR IGNORE INTO event(songId, timestamp, playTime) VALUES (?, ?, ?);

recentEvents:
SELECT * FROM event ORDER BY id DESC LIMIT ?;

recapEvents:
SELECT songId, timestamp, playTime FROM event
WHERE timestamp >= ? AND timestamp < ? ORDER BY timestamp;

totalListeningTimeMs:
SELECT COALESCE(SUM(playTime), 0) FROM event;

incrementTotalPlayTime:
UPDATE song SET totalPlayTime = totalPlayTime + ? WHERE id = ?;

clearListenHistory:
DELETE FROM event;

mostPlayedSongs:
SELECT songId, COUNT(1) AS playCount, SUM(playTime) AS totalPlayTime
FROM event GROUP BY songId ORDER BY totalPlayTime DESC LIMIT ?;

uniqueSongCountInRange:
SELECT COUNT(DISTINCT songId) FROM event WHERE timestamp >= ? AND timestamp < ?;

-- Search history
searchHistory:
SELECT id, query FROM search_history WHERE query LIKE ? || '%' ORDER BY id DESC LIMIT ?;

insertSearchHistory:
INSERT OR REPLACE INTO search_history(query) VALUES (?);

clearSearchHistory:
DELETE FROM search_history;

-- Playlists
insertPlaylistSong:
INSERT INTO playlist_song_map(playlistId, songId, position, setVideoId) VALUES (?, ?, ?, ?);

playlistSongIds:
SELECT songId FROM playlist_song_map WHERE playlistId = ? ORDER BY position;

clearPlaylist:
DELETE FROM playlist_song_map WHERE playlistId = ?;

removePlaylistSongsFrom:
DELETE FROM playlist_song_map WHERE playlistId = ? AND position >= ?;

bookmarkPlaylist:
UPDATE playlist SET bookmarkedAt = ? WHERE id = ?;

bookmarkedPlaylists:
SELECT * FROM playlist WHERE bookmarkedAt IS NOT NULL ORDER BY bookmarkedAt DESC;

-- Lyrics
selectLyrics:
SELECT * FROM lyrics WHERE id = ?;

insertLyrics:
INSERT OR REPLACE INTO lyrics(id, lyrics, provider, translatedLyrics, translationLanguage, translationMode)
VALUES (?, ?, ?, ?, ?, ?);

-- Speed dial (limit enforced in MusicDatabase, MaxPinned = 9)
speedDialItems:
SELECT * FROM speed_dial_item ORDER BY createDate DESC LIMIT 9;
